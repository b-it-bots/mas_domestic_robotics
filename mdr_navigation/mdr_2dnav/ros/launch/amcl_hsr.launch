<?xml version="1.0"?>
<launch>
    <!--
    AMCL for HSR Robot - Mode 2 Compatible
    This launch file provides HSR-compatible AMCL configuration
    -->

    <node pkg="amcl" type="amcl" name="amcl" output="screen">
        <remap from="scan" to="/hsrb/base_scan"/>
        <remap from="amcl_pose" to="/laser_2d_pose"/>

        <param name="odom_model_type" value="omni"/>
        <param name="odom_alpha1" value="1.5"/>
        <param name="odom_alpha2" value="0.5"/>
        <param name="odom_alpha3" value="0.5"/>
        <param name="odom_alpha4" value="1.5"/>
        <param name="odom_alpha5" value="1.5"/>
        <param name="odom_frame_id" value="odom"/>
        <param name="base_frame_id" value="base_link"/>
        <param name="global_frame_id" value="map"/>

        <param name="min_particles" value="500"/>
        <param name="max_particles" value="2000"/>
        <param name="kld_err" value="0.01"/>
        <param name="kld_z" value="0.99"/>
        <param name="update_min_d" value="0.1"/>
        <param name="update_min_a" value="0.25"/>
        <param name="resample_interval" value="2"/>
        <param name="transform_tolerance" value="0.5"/>
        <param name="recovery_alpha_slow" value="0.0"/>
        <param name="recovery_alpha_fast" value="0.0"/>
        <param name="gui_publish_rate" value="10.0"/>
        <param name="save_pose_rate" value="0.5"/>

        <param name="laser_model_type" value="likelihood_field"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="laser_max_beams" value="30"/>
        <param name="laser_min_range" value="-1.0"/>
        <param name="laser_max_range" value="-1.0"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_z_rand" value="0.05"/>
        <param name="laser_sigma_hit" value="0.2"/>
    </node>
</launch>
