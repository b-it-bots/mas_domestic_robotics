#!/usr/bin/env python3
"""Move base client — proper timeout replacement for move_base_action_client_test
Usage: rosrun mdr_move_base_action move_base_client DESTINATION [TIMEOUT_SEC]
"""
import sys
import rospy
import actionlib
from mdr_move_base_action.msg import MoveBaseAction, MoveBaseGoal

if len(sys.argv) < 2:
    print("Usage: rosrun mdr_move_base_action move_base_client DESTINATION [TIMEOUT_SEC]")
    sys.exit(1)

destination = sys.argv[1]
timeout = float(sys.argv[2]) if len(sys.argv) > 2 else 120.0

rospy.init_node('mdr_move_base_client')
client = actionlib.SimpleActionClient('move_base_server', MoveBaseAction)
rospy.loginfo("Waiting for move_base_server...")
client.wait_for_server()

goal = MoveBaseGoal()
goal.goal_type = MoveBaseGoal.NAMED_TARGET
goal.destination_location = destination

rospy.loginfo(f"Sending goal: {destination}  (timeout: {timeout}s)")
client.send_goal(goal)

if client.wait_for_result(rospy.Duration.from_sec(timeout)):
    result = client.get_result()
    state  = client.get_state()
    rospy.loginfo(f"Done — state: {state}, success: {result.success if result else None}")
else:
    rospy.logerr(f"Timed out after {timeout}s — goal cancelled")
    client.cancel_goal()
